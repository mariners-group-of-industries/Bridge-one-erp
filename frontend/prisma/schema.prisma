  unitPrice   Decimal      @default(0) @db.Decimal(14, 2)
  lineTotal   Decimal      @default(0) @db.Decimal(14, 2)
  remarks     String?      @db.VarChar(500)

  receipt     GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item        Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([receiptId, lineNo])
  @@map("goods_receipt_lines")
