enum PurchaseRequisitionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ORDERED
  CANCELLED
}

enum PurchaseRequisitionPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model PurchaseRequisition {
  id              String                      @id @default(uuid()) @db.Uuid
  businessUnitId  String                      @db.Uuid
  officeId        String                      @db.Uuid
  warehouseId     String?                     @db.Uuid
  number          String                      @db.VarChar(30)
  department      String                      @db.VarChar(100)
  requestedBy     String                      @db.VarChar(150)
  requisitionDate DateTime                    @db.Date
  requiredDate    DateTime                    @db.Date
  status          PurchaseRequisitionStatus   @default(PENDING)
  priority        PurchaseRequisitionPriority @default(MEDIUM)
  requestType     String                      @default("LOCAL") @db.VarChar(30)
  purchaseMethod  String                      @default("DIRECT") @db.VarChar(30)
  totalEstimated  Decimal                     @default(0) @db.Decimal(14, 2)
  notes           String?                     @db.VarChar(1000)
  createdAt       DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                    @updatedAt @db.Timestamptz(3)

  businessUnit    BusinessUnit                @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  office          Office                      @relation(fields: [officeId], references: [id], onDelete: Restrict)
  warehouse       Warehouse?                  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  lines           PurchaseRequisitionLine[]
  purchaseOrders  PurchaseOrder[]

  @@unique([businessUnitId, number])
  @@index([businessUnitId, status, requisitionDate])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionLine {
  id                 String              @id @default(uuid()) @db.Uuid
  requisitionId      String              @db.Uuid
  lineNo             Int
  itemId             String?             @db.Uuid
  itemCode           String              @db.VarChar(50)
  itemName           String              @db.VarChar(200)
  uom                String              @default("Pcs") @db.VarChar(20)
  quantity           Decimal             @db.Decimal(14, 3)
  estimatedUnitPrice Decimal             @default(0) @db.Decimal(14, 2)
  lineTotal          Decimal             @default(0) @db.Decimal(14, 2)
  remarks            String?             @db.VarChar(500)

  requisition        PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  item               Item?               @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([requisitionId, lineNo])
  @@map("purchase_requisition_lines")
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  PARTIAL_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id                   String              @id @default(uuid()) @db.Uuid
  businessUnitId       String              @db.Uuid
  officeId             String              @db.Uuid
  warehouseId          String?             @db.Uuid
  supplierId           String              @db.Uuid
  requisitionId        String?             @db.Uuid
  number               String              @db.VarChar(30)
  orderDate            DateTime            @db.Date
  expectedDeliveryDate DateTime?           @db.Date
  referenceNumber      String?             @db.VarChar(100)
  projectCostCenter    String?             @db.VarChar(100)
  status               PurchaseOrderStatus @default(PENDING)
  subtotal             Decimal             @default(0) @db.Decimal(14, 2)
  totalDiscount        Decimal             @default(0) @db.Decimal(14, 2)
  totalTax             Decimal             @default(0) @db.Decimal(14, 2)
  shippingFee          Decimal             @default(0) @db.Decimal(14, 2)
  totalAmount          Decimal             @default(0) @db.Decimal(14, 2)
  notes                String?             @db.VarChar(1000)
  createdBy            String              @db.VarChar(150)
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)

  businessUnit         BusinessUnit        @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  office               Office              @relation(fields: [officeId], references: [id], onDelete: Restrict)
  warehouse            Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  requisition          PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  lines                PurchaseOrderLine[]
  goodsReceipts        GoodsReceipt[]
  returns              PurchaseReturn[]
  payments             SupplierPayment[]

  @@unique([businessUnitId, number])
  @@index([businessUnitId, status, orderDate])
  @@index([supplierId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @db.Uuid
  lineNo           Int
