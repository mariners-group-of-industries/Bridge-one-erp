enum GoodsReceiptStatus {
  DRAFT
  RECEIVED
  INSPECTED
  CANCELLED
}

model GoodsReceipt {
  id               String             @id @default(uuid()) @db.Uuid
  businessUnitId   String             @db.Uuid
  officeId         String             @db.Uuid
  warehouseId      String?            @db.Uuid
