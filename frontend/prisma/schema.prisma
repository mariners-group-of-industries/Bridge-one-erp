// BridgeOne ERP — Prisma schema
// Connection URLs live in prisma.config.ts (Prisma 7); never hardcode credentials here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMINISTRATOR
  MANAGER
  STAFF
}

/// Dynamic named role — separate from the UserRole system enum.
/// Permissions for each role will be assigned in a future phase.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  users User[]

  @@map("roles")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(150)
  phone        String    @unique @db.VarChar(30)
  passwordHash String    @db.VarChar(500)
  role         UserRole  @default(STAFF)
  roleId       String?   @db.Uuid
  isMaster     Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  sessions    UserSession[]
  dynamicRole Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)

  employee            Employee?  @relation("EmployeeUser")
  employeeLastActions Employee[] @relation("EmployeeLastActionBy")

  businessUnitAccess UserBusinessUnitAccess[]
  officeAccess       UserOfficeAccess[]
  warehouseAccess    UserWarehouseAccess[]

  superApproverOf ApprovalPipeline[]      @relation("PipelineSuperUser")
  userGroups      UserGroupMember[]
  approverOf      ApprovalStageApprover[] @relation("ApproverUser")

  @@index([roleId])
  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  jti       String   @unique @db.VarChar(100) // JWT ID — used for revocation
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ─── Organizational access assignments ───────────────────────────────────────

model UserBusinessUnitAccess {
  userId         String   @db.Uuid
  businessUnitId String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@id([userId, businessUnitId])
  @@map("user_business_unit_access")
}

model UserOfficeAccess {
  userId    String   @db.Uuid
  officeId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@id([userId, officeId])
  @@map("user_office_access")
}

model UserWarehouseAccess {
  userId      String   @db.Uuid
  warehouseId String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@map("user_warehouse_access")
}

// ─── Configuration › Identity & Security › Approval Setup ───────────────────

/// An approval pipeline for one feature (Purchase Requisition …): a super
/// approver who can approve at any stage, then numbered stages of approvers.
/// `userType` USER points at `users`, EMPLOYEE at `employees`.
model ApprovalPipeline {
  id                      String   @id @default(uuid()) @db.Uuid
  name                    String   @unique @db.VarChar(150)
  feature                 String   @db.VarChar(60)
  userType                String   @default("USER") @db.VarChar(10)
  superApproverUserId     String?  @db.Uuid
  superApproverEmployeeId String?  @db.Uuid
  remarks                 String?  @db.VarChar(500)
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  superApproverUser     User?           @relation("PipelineSuperUser", fields: [superApproverUserId], references: [id], onDelete: SetNull)
  superApproverEmployee Employee?       @relation("PipelineSuperEmployee", fields: [superApproverEmployeeId], references: [id], onDelete: SetNull)
  stages                ApprovalStage[]

  @@index([feature])
  @@map("approval_pipelines")
}

/// A stage of a pipeline. `approvalOrder` ANY (any `requiredCount` approvers)
/// or SEQUENTIAL (in list order).
model ApprovalStage {
  id            String   @id @default(uuid()) @db.Uuid
  pipelineId    String   @db.Uuid
  stageNo       Int
  name          String   @db.VarChar(150)
  approvalOrder String   @db.VarChar(20)
  requiredCount Int      @default(1)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  pipeline  ApprovalPipeline        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  approvers ApprovalStageApprover[]

  @@unique([pipelineId, stageNo])
  @@map("approval_stages")
}

model ApprovalStageApprover {
  id                String  @id @default(uuid()) @db.Uuid
  stageId           String  @db.Uuid
  sortOrder         Int     @default(0)
  userType          String  @db.VarChar(10)
  businessUnitId    String? @db.Uuid
  userId            String? @db.Uuid
  employeeId        String? @db.Uuid
  authorizationType String  @db.VarChar(20)

  stage        ApprovalStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  user         User?         @relation("ApproverUser", fields: [userId], references: [id], onDelete: Cascade)
  employee     Employee?     @relation("ApproverEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([stageId])
  @@map("approval_stage_approvers")
}

// ─── Configuration › Identity & Security › User Group / Permission Group ────

/// A named set of users. `updatedById`/`updatedByName` record the last action
/// (a name snapshot, so the list still reads after the user is gone).
model UserGroup {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique @db.VarChar(150)
  updatedById   String?  @db.VarChar(100)
  updatedByName String?  @db.VarChar(150)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  members UserGroupMember[]

  @@map("user_groups")
}

model UserGroupMember {
  groupId   String @db.Uuid
  userId    String @db.Uuid
  sortOrder Int    @default(0)

  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("user_group_members")
}

/// A permission matrix: per activity (a menu page, keyed by its path) which of
/// Create / Edit / View / Delete / Approve are allowed. Only granted rows are stored.
model PermissionGroup {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique @db.VarChar(150)
  updatedById   String?  @db.VarChar(100)
  updatedByName String?  @db.VarChar(150)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  entries PermissionGroupEntry[]

  @@map("permission_groups")
}

model PermissionGroupEntry {
  groupId      String  @db.Uuid
  activityKey  String  @db.VarChar(200)
  moduleName   String  @db.VarChar(100)
  activityName String  @db.VarChar(150)
  canCreate    Boolean @default(false)
  canEdit      Boolean @default(false)
  canView      Boolean @default(false)
  canDelete    Boolean @default(false)
  canApprove   Boolean @default(false)

  group PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, activityKey])
  @@map("permission_group_entries")
}

// ─── Configuration › Community & Gateways › API Configuration ───────────────

/// A token for calling the API from other systems (`Authorization: Bearer …`).
/// Only a SHA-256 hash is stored; the token is shown once when generated.
/// `access` READ (GET only) or READ_WRITE.
model ApiToken {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(100)
  tokenPrefix   String    @db.VarChar(16)
  tokenHash     String    @unique @db.VarChar(64)
  access        String    @default("READ") @db.VarChar(20)
  expiresAt     DateTime? @db.Timestamptz(3)
  lastUsedAt    DateTime? @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  createdById   String?   @db.VarChar(100)
  createdByName String?   @db.VarChar(150)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@map("api_tokens")
}

// ─── Configuration › System Logs › Audit Logs ───────────────────────────────

/// One recorded action: a successful change through the API, an export, or a
/// sign-in / sign-out. Request bodies are never stored.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  feature    String   @db.VarChar(100)
  actionType String   @db.VarChar(20)
  userId     String?  @db.VarChar(100)
  userName   String?  @db.VarChar(150)
  method     String   @db.VarChar(10)
  path       String   @db.VarChar(300)
  entityId   String?  @db.VarChar(100)
  status     Int
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(300)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([feature, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ─── Configuration › Community & Gateways › Attendance Devices ──────────────

/// A biometric terminal (ZKTeco …) on the office LAN. The attendance agent on an
/// office PC reads it over TCP (`ipAddress`:`port`) and uploads its punches.
model AttendanceDevice {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(100)
  ipAddress     String    @db.VarChar(64)
  port          Int       @default(4370)
  serialNumber  String?   @db.VarChar(60)
  officeId      String?   @db.Uuid
  isActive      Boolean   @default(true)
  lastSyncAt    DateTime? @db.Timestamptz(3)
  lastSyncCount Int?
  lastError     String?   @db.VarChar(500)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  office  Office?           @relation(fields: [officeId], references: [id], onDelete: SetNull)
  punches AttendancePunch[]

  @@unique([ipAddress, port])
  @@map("attendance_devices")
}

/// One punch from a device. `deviceUserId` is the user number on the device and
/// is matched to an employee's Attendance ID (else Employee ID). The same punch
/// uploaded twice is stored once.
model AttendancePunch {
  id           String   @id @default(uuid()) @db.Uuid
  deviceId     String   @db.Uuid
  deviceUserId String   @db.VarChar(30)
  employeeId   String?  @db.Uuid
  punchTime    DateTime @db.Timestamptz(3)
  punchState   Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  device   AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([deviceId, deviceUserId, punchTime])
  @@index([employeeId, punchTime])
  @@index([punchTime])
  @@map("attendance_punches")
}

// ─── Configuration › Business Configuration › Company Profile ───────────────

enum DateFormat {
  DD_MM_YYYY_SLASH // DD/MM/YYYY
  MM_DD_YYYY_SLASH // MM/DD/YYYY
  YYYY_MM_DD_DASH // YYYY-MM-DD
  DD_MM_YYYY_DASH // DD-MM-YYYY
}

enum OfficeAssetKind {
  BRAND_LOGO
  HEADER
  FOOTER
}

enum TermsDomain {
  SALES
  PURCHASE
}

/// Document types a term can apply to. Each value belongs to exactly one
/// TermsDomain (enforced in the service layer); add new values here to support
/// new documents without new tables.
enum TermsDocumentType {
  SALES_QUOTATION
  SALES_ORDER
  SALES_DELIVERY
  PROFORMA_INVOICE
  REQUEST_FOR_QUOTATION
  PURCHASE_ORDER
  PURCHASE_RECEIVE
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(150)
  address   String   @db.VarChar(500)
  email     String   @db.VarChar(254)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  businessUnits BusinessUnit[]

  @@map("companies")
}

model BusinessUnit {
  id            String     @id @default(uuid()) @db.Uuid
  companyId     String     @db.Uuid
  name          String     @db.VarChar(150)
  address       String     @db.VarChar(500)
  contactNumber String     @db.VarChar(30)
  email         String     @db.VarChar(254)
  dateFormat    DateFormat @default(DD_MM_YYYY_SLASH)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  company    Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  offices    Office[]
  terms      TermsCondition[]
  userAccess UserBusinessUnitAccess[]

  salesPersons     SalesPerson[]
  customers        Customer[]
  items            Item[]
  salesDeliveries  SalesDelivery[]
  salesReturns     SalesReturn[]
  salesCollections SalesCollection[]
  salesTargets     SalesTarget[]
  salesQuotations  SalesQuotation[]
  sequences        DocumentSequence[]
  salesAreas       SalesArea[]
  customerGroups   CustomerGroup[]
  itemCategories   ItemCategory[]
  priceLists       PriceList[]
  salesOrders      SalesOrder[]
  deliveryReasons  DeliveryPendingReason[]
  vehicles         Vehicle[]
  stockEntries     StockEntry[]
  returnReasons    SalesReturnReason[]
  salesBills       SalesBill[]

  suppliers            Supplier[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  purchaseReturns      PurchaseReturn[]
  supplierPayments     SupplierPayment[]
  supplierGroups       SupplierGroup[]
  taxBrackets          TaxBracket[]
  itemDivisions        ItemDivision[]
  itemUoms             ItemUom[]
  salesOffers          SalesOffer[]
  customerPriceSetups  CustomerPriceSetup[]
  standardPrices       StandardPrice[]
  salesWallets         SalesWallet[]
  salesReturnPrices    SalesReturnPrice[]
  approvalApprovers   ApprovalStageApprover[]
  groupPriceSetups     CustomerGroupPriceSetup[]
  openingStockReceipts OpeningStockReceipt[]
  territoryLayers      SalesTerritoryLayer[]
  territoryNodes       SalesTerritoryNode[]
  workCenters       ProductionWorkCenter[]
  productionEntries ProductionEntry[]
  workCenterTypes        ProductionWorkCenterType[]
  productionDepartments  ProductionDepartment[]
  productionBoms         ProductionBom[]
  productionOrders       ProductionOrder[]
  targetBudgets    SalesTargetBudget[]
  targetPlans      SalesTargetPlan[]
  commissions      SalesCommission[]

  @@unique([companyId, name])
  @@map("business_units")
}

model Office {
  id             String   @id @default(uuid()) @db.Uuid
  businessUnitId String   @db.Uuid
  name           String   @db.VarChar(150)
  address        String   @db.VarChar(500)
  email          String?  @db.VarChar(254)
  phone          String?  @db.VarChar(30)
  binNumber      String?  @db.VarChar(30)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit       @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  warehouses   Warehouse[]
  assets       OfficeAsset[]
  employees    Employee[]
  userAccess   UserOfficeAccess[]
  quotations   SalesQuotation[]
  salesOrders  SalesOrder[]
  deliveries   SalesDelivery[]
  returns      SalesReturn[]
  collections  SalesCollection[]
  bills        SalesBill[]

  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  purchaseReturns      PurchaseReturn[]
  suppliers            Supplier[]
  customers            Customer[]
  openingStockReceipts OpeningStockReceipt[]
  groupPriceSetups     CustomerGroupPriceSetup[]
  salesWallets         SalesWallet[]
  attendanceDevices    AttendanceDevice[]
  payrollRuns          PayrollRun[]
  bonusRuns            BonusRun[]
  hrPolicyRecords      HrPolicyRecord[]
  workCenters       ProductionWorkCenter[]
  productionEntries ProductionEntry[]
  productionOrders  ProductionOrder[]
  targetPlans  SalesTargetPlan[]

  @@unique([businessUnitId, name])
  @@map("offices")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @db.Uuid
  name      String   @db.VarChar(150)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  office     Office                @relation(fields: [officeId], references: [id], onDelete: Restrict)
  userAccess UserWarehouseAccess[]

  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  purchaseReturns      PurchaseReturn[]
  openingStockReceipts OpeningStockReceipt[]

  deliveries   SalesDelivery[]
  returns      SalesReturn[]
  stockEntries StockEntry[]
  productionWorkCenters ProductionWorkCenter[]
  productionOrders ProductionOrder[]
  productionSourceEntries ProductionEntry[] @relation("EntrySourceWarehouse")
  productionOutputEntries ProductionEntry[] @relation("EntryOutputWarehouse")

  @@unique([officeId, name])
  @@map("warehouses")
}

/// Metadata for an office branding file. The binary lives in object storage;
/// only the storage key is kept here.
model OfficeAsset {
  id           String          @id @default(uuid()) @db.Uuid
  officeId     String          @db.Uuid
  kind         OfficeAssetKind
  storageKey   String          @unique @db.VarChar(300)
  originalName String          @db.VarChar(255)
  mimeType     String          @db.VarChar(100)
  sizeBytes    Int
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([officeId, kind])
  @@map("office_assets")
}

model TermsCondition {
  id             String      @id @default(uuid()) @db.Uuid
  businessUnitId String      @db.Uuid
  domain         TermsDomain
  content        String      @db.VarChar(2000)
  isDefault      Boolean     @default(false)
  sortOrder      Int
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  businessUnit  BusinessUnit        @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  applicability TermApplicability[]

  @@index([businessUnitId, domain, sortOrder])
  @@map("terms_conditions")
}

model TermApplicability {
  termId       String            @db.Uuid
  documentType TermsDocumentType
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  term TermsCondition @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([termId, documentType])
  @@index([documentType])
  @@map("term_applicability")
}

// ─── Sales ───────────────────────────────────────────────────────────────────
// Every sales record belongs to a business unit, so company scoping follows
// BusinessUnit.companyId.

/// Lifecycle of a sales document (ERPNext docstatus). Only SUBMITTED documents
/// count in balances, reports and the dashboard.
enum SalesDocStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum CollectionMethod {
  CASH
  BANK
  CHEQUE
  MOBILE_BANKING
}

model SalesPerson {
  id             String   @id @default(uuid()) @db.Uuid
  businessUnitId String   @db.Uuid
  code           String   @db.VarChar(30)
  name           String   @db.VarChar(150)
  designation    String?  @db.VarChar(100)
  phone          String?  @db.VarChar(30)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  customers    Customer[]
  deliveries   SalesDelivery[]
  returns      SalesReturn[]
  collections  SalesCollection[]
  targets      SalesTarget[]
  quotations   SalesQuotation[]
  salesOrders  SalesOrder[]
  targetAssignments SalesTargetAssignment[]
  commissions       SalesCommission[]

  @@unique([businessUnitId, code])
  @@map("sales_persons")
}

model Customer {
  id              String       @id @default(uuid()) @db.Uuid
  businessUnitId  String       @db.Uuid
  code            String       @db.VarChar(30)
  name            String       @db.VarChar(150)
  address         String?      @db.VarChar(500)
  phone           String?      @db.VarChar(30)
  email           String?      @db.VarChar(254)
  contactPerson   String?      @db.VarChar(150)
  binNumber       String?      @db.VarChar(30)
  customerType    CustomerType @default(GENERAL)
  customerGroupId String?      @db.Uuid
  zoneId          String?      @db.Uuid
  territoryId     String?      @db.Uuid
  routeId         String?      @db.Uuid
  sectionId       String?      @db.Uuid
  /// Days after delivery before an unpaid amount becomes overdue.
  creditDays      Int          @default(0)
  creditLimit     Decimal?     @db.Decimal(14, 2)
  /// Default sales person for new documents.
  salesPersonId   String?      @db.Uuid
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  // Customer Profile (Configuration / Entity Master Data). `phone` is the mobile
  // number, `address` the billing address and `contactPerson` the billing contact.
  officeId                   String?   @db.Uuid
  subGroupId                 String?   @db.Uuid
  tolerancePercent           Decimal?  @db.Decimal(5, 2)
  priceListId                String?   @db.Uuid
  tcsPercent                 Decimal?  @db.Decimal(5, 2)
  vatRegistrationNo          String?   @db.VarChar(50)
  tinNumber                  String?   @db.VarChar(50)
  tradeLicenseNo             String?   @db.VarChar(50)
  maritalStatus              String?   @db.VarChar(20)
  marriageDate               DateTime? @db.Date
  birthDate                  DateTime? @db.Date
  gender                     String?   @db.VarChar(20)
  nidNumber                  String?   @db.VarChar(30)
  isMonthly                  Boolean   @default(false)
  creditLimitAllOutlets      Boolean   @default(false)
  isForeign                  Boolean   @default(false)
  isDistributor              Boolean   @default(false)
  isEmployeeCustomer         Boolean   @default(false)
  isAnonymous                Boolean   @default(false)
  vatAccountingNotApplicable Boolean   @default(false)
  availableBalanceCheck      Boolean   @default(false)
  onlyBusinessUnitWise       Boolean   @default(false)
  isUser                     Boolean   @default(false)
  districtId                 Int?
  thanaId                    String?   @db.Uuid
  billingName                String?   @db.VarChar(150)
  billingContactNo           String?   @db.VarChar(30)
  taxBracketId               String?   @db.Uuid
  remarks                    String?   @db.VarChar(1000)
  /// Partner Bank Information.
  bankAccountType            String?   @db.VarChar(50)
  bankAccountNo              String?   @db.VarChar(50)
  bankBranch                 String?   @db.VarChar(100)
  bankName                   String?   @db.VarChar(100)
  bankRoutingNo              String?   @db.VarChar(30)

  businessUnit  BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  salesPerson   SalesPerson?      @relation(fields: [salesPersonId], references: [id], onDelete: SetNull)
  deliveries    SalesDelivery[]
  returns       SalesReturn[]
  collections   SalesCollection[]
  bills         SalesBill[]
  quotations    SalesQuotation[]
  salesOrders   SalesOrder[]
  addresses     CustomerAddress[]
  customerGroup CustomerGroup?    @relation(fields: [customerGroupId], references: [id], onDelete: Restrict)
  zone          SalesArea?        @relation("CustomerZone", fields: [zoneId], references: [id], onDelete: Restrict)
  territory     SalesArea?        @relation("CustomerTerritory", fields: [territoryId], references: [id], onDelete: Restrict)
  route         SalesArea?        @relation("CustomerRoute", fields: [routeId], references: [id], onDelete: Restrict)
  section       SalesArea?        @relation("CustomerSection", fields: [sectionId], references: [id], onDelete: Restrict)
  office        Office?           @relation(fields: [officeId], references: [id], onDelete: Restrict)
  subGroup      CustomerGroup?    @relation("CustomerSubGroup", fields: [subGroupId], references: [id], onDelete: SetNull)
  priceList     PriceList?        @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  district      District?         @relation(fields: [districtId], references: [id], onDelete: SetNull)
  thana         Thana?            @relation(fields: [thanaId], references: [id], onDelete: SetNull)
  taxBracket    TaxBracket?       @relation(fields: [taxBracketId], references: [id], onDelete: SetNull)
  attachments   CustomerAttachment[]
  priceSetups   CustomerPriceSetup[]
  productionOrders ProductionOrder[]
  targetPlanLines SalesTargetPlanLine[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, name])
  @@index([officeId])
  @@map("customers")
}

/// Sellable product. Owned by Sales until the Stock module takes over item masters.
model Item {
  id                       String   @id @default(uuid()) @db.Uuid
  businessUnitId           String   @db.Uuid
  code                     String   @db.VarChar(30)
  name                     String   @db.VarChar(200)
  uom                      String   @default("Pcs") @db.VarChar(20)
  salesRate                Decimal  @default(0) @db.Decimal(14, 2)
  mrp                      Decimal? @db.Decimal(14, 2)
  vatPercent               Decimal  @default(0) @db.Decimal(5, 2)
  /// Larger packing unit (Ctn, Bag …) and how many base units it holds.
  altUom                   String?  @db.VarChar(20)
  altUomFactor             Decimal? @db.Decimal(14, 3)
  /// Extra % that may be delivered over the ordered quantity.
  deliveryTolerancePercent Decimal  @default(0) @db.Decimal(5, 2)
  categoryId               String?  @db.Uuid
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @db.Timestamptz(3)

  // Item Profile (Configuration / Entity Master Data). `code`/`name` are the master
  // item code and name, `salesRate` the selling price and `mrp` the retail price.
  printedCode    String?  @db.VarChar(30)
  printedName    String?  @db.VarChar(200)
  itemType       String?  @db.VarChar(30)
  divisionId     String?  @db.Uuid
  barcode        String?  @db.VarChar(60)
  brand          String?  @db.VarChar(100)
  dealerPrice    Decimal? @db.Decimal(14, 2)
  tradingPrice   Decimal? @db.Decimal(14, 2)
  purchasePrice  Decimal? @db.Decimal(14, 2)
  netWeight      Decimal? @db.Decimal(14, 3)
  netWeightUnit  String?  @db.VarChar(20)
  restrictedAge  String?  @db.VarChar(10)
  /// NONE or BOTH (batch and serial tracking).
  tracking       String   @default("NONE") @db.VarChar(10)
  autoBarcode    Boolean  @default(false)
  canBeSold      Boolean  @default(true)
  canBePurchased Boolean  @default(true)
  canBeRented    Boolean  @default(false)
  noDecimal      Boolean  @default(false)
  allowEbt       Boolean  @default(false)
  isDefault      Boolean  @default(false)

  businessUnit   BusinessUnit         @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  category       ItemCategory?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  division       ItemDivision?        @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  openingStockLines OpeningStockLine[]
  offerSellingLines  SalesOfferItemLine[]     @relation("OfferSellingItem")
  offerFreeLines     SalesOfferItemLine[]     @relation("OfferFreeItem")
  offerPairLines     SalesOfferPairLine[]     @relation("OfferPairItem")
  offerBonusLines    SalesOfferBonusLine[]    @relation("OfferBonusItem")
  offerDiscountLines SalesOfferDiscountLine[] @relation("OfferDiscountItem")
  customerPriceLines      CustomerPriceLine[]
  customerGroupPriceLines CustomerGroupPriceLine[]
  standardPrices          StandardPrice[]
  salesReturnPrices       SalesReturnPrice[]
  prices         ItemPrice[]
  orderLines     SalesOrderLine[]
  stockEntries   StockEntry[]
  deliveryLines  SalesDeliveryLine[]
  returnLines    SalesReturnLine[]
  quotationLines SalesQuotationLine[]

  requisitionLines    PurchaseRequisitionLine[]
  purchaseOrderLines  PurchaseOrderLine[]
  goodsReceiptLines   GoodsReceiptLine[]
  purchaseReturnLines PurchaseReturnLine[]
  productionEntries ProductionEntry[]
  bomOutputs   ProductionBomOutput[]
  bomMaterials ProductionBomMaterial[]
  bomWastages  ProductionBomWastage[]
  productionOrders        ProductionOrder[]
  productionOrderMaterials ProductionOrderMaterial[]
  productionEntryMaterials ProductionEntryMaterial[]
  targetPlanLines SalesTargetPlanLine[]
  commissionLines SalesCommissionLine[]

  @@unique([businessUnitId, code])
  @@map("items")
}

/// Goods delivered to a customer; the amount becomes overdue after `dueDate`.
/// Goods delivered to a customer (sales invoice + challan). SUBMITTED rows
/// are the sales ledger: the dashboard and receivables read them. The amount
/// becomes overdue after `dueDate`.
model SalesDelivery {
  id                 String               @id @default(uuid()) @db.Uuid
  businessUnitId     String               @db.Uuid
  /// Invoice number (SD-YYYY-NNNNN).
  number             String               @db.VarChar(30)
  /// Null only for ledger rows created before Sales Delivery existed.
  officeId           String?              @db.Uuid
  warehouseId        String?              @db.Uuid
  salesOrderId       String?              @db.Uuid
  customerId         String               @db.Uuid
  salesPersonId      String?              @db.Uuid
  deliveryType       DeliveryType         @default(DIRECT)
  deliveryDate       DateTime             @db.Date
  /// Date and time the goods left (Delivery Date Time on the form).
  deliveredAt        DateTime?            @db.Timestamptz(3)
  /// deliveryDate + payment term days, fixed when the delivery is saved.
  dueDate            DateTime             @db.Date
  status             SalesDocStatus       @default(DRAFT)
  confirmation       DeliveryConfirmation @default(PENDING)
  challanNo          String?              @db.VarChar(30)
  vatChallanNo       String?              @db.VarChar(40)
  shipToAddressId    String?              @db.Uuid
  shippingAddress    String?              @db.VarChar(500)
  billingAddress     String?              @db.VarChar(500)
  contactPerson      String?              @db.VarChar(150)
  refCustomerPo      String?              @db.VarChar(60)
  refCustomerPoDate  DateTime?            @db.Date
  refInvoice         String?              @db.VarChar(60)
  refProjectOutlet   String?              @db.VarChar(150)
  paymentMethod      PaymentMethod        @default(CASH)
  paymentTermDays    Int                  @default(0)
  priceIncludesVat   Boolean              @default(true)
  vehicleNo          String?              @db.VarChar(40)
  driverName         String?              @db.VarChar(100)
  driverPhone        String?              @db.VarChar(30)
  transporterName    String?              @db.VarChar(150)
  /// Registered vehicle (vehicleNo keeps its number as it was).
  vehicleId          String?              @db.Uuid
  /// Driver (Employee); driverName is the external driver's name.
  driverEmployeeId   String?              @db.Uuid
  securityCode       String?              @db.VarChar(40)
  referredBy         String?              @db.VarChar(150)
  /// Buyer's name and mobile when the customer is the anonymous (walk-in) one.
  buyerName          String?              @db.VarChar(150)
  buyerMobile        String?              @db.VarChar(30)
  salesType          SalesOrderType       @default(SALES)
  totalQty           Decimal              @default(0) @db.Decimal(14, 3)
  itemsTotal         Decimal              @default(0) @db.Decimal(14, 2)
  itemsBase          Decimal              @default(0) @db.Decimal(14, 2)
  vatAmount          Decimal              @default(0) @db.Decimal(14, 2)
  aitAmount          Decimal              @default(0) @db.Decimal(14, 2)
  discountAmount     Decimal              @default(0) @db.Decimal(14, 2)
  deliveryCharge     Decimal              @default(0) @db.Decimal(14, 2)
  unloadingCharge    Decimal              @default(0) @db.Decimal(14, 2)
  /// Invoice total: the receivable (itemsTotal − discount + charges).
  totalAmount        Decimal              @default(0) @db.Decimal(14, 2)
  /// Collected on delivery (a linked SalesCollection holds it).
  paidAmount         Decimal              @default(0) @db.Decimal(14, 2)
  terms              String?              @db.VarChar(4000)
  remarks            String?              @db.VarChar(500)
  /// For EXCHANGE: the return of the goods taken back.
  exchangeReturnId   String?              @unique @db.Uuid
  actualDeliveryDate DateTime?            @db.Date
  confirmedAt        DateTime?            @db.Timestamptz(3)
  confirmedBy        String?              @db.VarChar(100)
  deletedAt          DateTime?            @db.Timestamptz(3)
  deletedBy          String?              @db.VarChar(100)
  deleteReason       String?              @db.VarChar(500)
  createdBy          String?              @db.VarChar(100)
  updatedBy          String?              @db.VarChar(100)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)

  businessUnit   BusinessUnit                @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  office         Office?                     @relation(fields: [officeId], references: [id], onDelete: Restrict)
  warehouse      Warehouse?                  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  salesOrder     SalesOrder?                 @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  customer       Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesPerson    SalesPerson?                @relation(fields: [salesPersonId], references: [id], onDelete: Restrict)
  shipTo         CustomerAddress?            @relation(fields: [shipToAddressId], references: [id], onDelete: SetNull)
  exchangeReturn SalesReturn?                @relation("ExchangeReturn", fields: [exchangeReturnId], references: [id], onDelete: Restrict)
  vehicle        Vehicle?                    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver         Employee?                   @relation("DeliveryDriver", fields: [driverEmployeeId], references: [id], onDelete: SetNull)
  lines          SalesDeliveryLine[]
  returns        SalesReturn[]
  collections    SalesCollection[]
  allocations    SalesCollectionAllocation[]
  billLines      SalesBillLine[]

  @@unique([businessUnitId, number])
  @@unique([businessUnitId, challanNo])
  @@index([businessUnitId, status, deliveryDate])
  @@index([customerId, status, dueDate])
  @@index([salesOrderId])
  @@index([officeId, deliveryType, deliveryDate])
  @@index([vehicleId])
  @@map("sales_deliveries")
}

/// Vehicles that carry deliveries (own or rented), with their default driver.
model Vehicle {
  id               String   @id @default(uuid()) @db.Uuid
  businessUnitId   String   @db.Uuid
  vehicleNumber    String   @db.VarChar(40)
  vehicleSize      String?  @db.VarChar(50)
  chassisNumber    String?  @db.VarChar(60)
  vehicleName      String?  @db.VarChar(100)
  serviceProvider  String?  @db.VarChar(150)
  contactNumber    String?  @db.VarChar(30)
  isRent           Boolean  @default(false)
  isCargo          Boolean  @default(false)
  driverEmployeeId String?  @db.Uuid
  driverName       String?  @db.VarChar(100)
  driverContact    String?  @db.VarChar(30)
  securityCode     String?  @db.VarChar(40)
  isActive         Boolean  @default(true)
  createdBy        String   @db.VarChar(100)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit         @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  driver       Employee?            @relation("VehicleDriver", fields: [driverEmployeeId], references: [id], onDelete: SetNull)
  compartments VehicleCompartment[]
  deliveries   SalesDelivery[]

  @@unique([businessUnitId, vehicleNumber])
  @@map("vehicles")
}

/// Compartments of a vehicle (e.g. tanks of a tanker) and what each holds.
model VehicleCompartment {
  id              String  @id @default(uuid()) @db.Uuid
  vehicleId       String  @db.Uuid
  compartmentNo   Int
  compartmentType String  @db.VarChar(60)
  compartmentName String  @db.VarChar(60)
  capacity        Decimal @db.Decimal(14, 3)
  uom             String  @db.VarChar(20)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, compartmentNo])
  @@map("vehicle_compartments")
}

model SalesDeliveryLine {
  id              String   @id @default(uuid()) @db.Uuid
  deliveryId      String   @db.Uuid
  lineNo          Int
  itemId          String   @db.Uuid
  /// The sales order line this delivers (null for direct deliveries).
  orderLineId     String?  @db.Uuid
  uom             String?  @db.VarChar(20)
  altUom          String?  @db.VarChar(20)
  altUomFactor    Decimal? @db.Decimal(14, 3)
  qty             Decimal  @db.Decimal(14, 3)
  /// Unit price as entered (VAT-inclusive when the delivery says so).
  rate            Decimal  @db.Decimal(14, 4)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  vatPercent      Decimal  @default(0) @db.Decimal(5, 2)
  aitPercent      Decimal  @default(0) @db.Decimal(5, 2)
  grossAmount     Decimal  @default(0) @db.Decimal(14, 2)
  baseAmount      Decimal  @default(0) @db.Decimal(14, 2)
  vatAmount       Decimal  @default(0) @db.Decimal(14, 2)
  aitAmount       Decimal  @default(0) @db.Decimal(14, 2)
  /// Line total (after line discount, VAT/AIT included).
  amount          Decimal  @db.Decimal(14, 2)

  delivery    SalesDelivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  item        Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  orderLine   SalesOrderLine?   @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  returnLines SalesReturnLine[]

  @@unique([deliveryId, lineNo])
  @@index([itemId])
  @@index([orderLineId])
  @@map("sales_delivery_lines")
}

/// Goods returned by a customer; reduces sales and the customer's receivable.
/// Goods a customer gives back. DRAFT = waiting for approval, SUBMITTED =
/// approved (credits the customer and, for sales returns, puts the goods back
/// in stock), CANCELLED = deleted.
model SalesReturn {
  id                String          @id @default(uuid()) @db.Uuid
  businessUnitId    String          @db.Uuid
  number            String          @db.VarChar(30)
  kind              SalesReturnKind @default(SALES)
  mode              SalesReturnMode @default(WITHOUT_REFERENCE)
  customerId        String          @db.Uuid
  salesPersonId     String?         @db.Uuid
  /// The delivery returned against (FULL / PARTIAL).
  deliveryId        String?         @db.Uuid
  officeId          String?         @db.Uuid
  warehouseId       String?         @db.Uuid
  createdBy         String?         @db.VarChar(100)
  returnDate        DateTime        @db.Date
  status            SalesDocStatus  @default(DRAFT)
  priceIncludesVat  Boolean         @default(true)
  /// The customer has no invoice for the goods: no VAT is credited.
  withoutInvoice    Boolean         @default(false)
  shippingAddress   String?         @db.VarChar(500)
  refProjectOutlet  String?         @db.VarChar(150)
  refNo             String?         @db.VarChar(60)
  refDate           DateTime?       @db.Date
  refAmount         Decimal?        @db.Decimal(14, 2)
  requestNo         String?         @db.VarChar(60)
  remarks           String?         @db.VarChar(500)
  totalQty          Decimal         @default(0) @db.Decimal(14, 3)
  itemsTotal        Decimal         @default(0) @db.Decimal(14, 2)
  itemsBase         Decimal         @default(0) @db.Decimal(14, 2)
  vatAmount         Decimal         @default(0) @db.Decimal(14, 2)
  aitAmount         Decimal         @default(0) @db.Decimal(14, 2)
  /// Share of the delivery's header discount the customer gives back.
  discountAmount    Decimal         @default(0) @db.Decimal(14, 2)
  /// Credit to the customer: itemsTotal − discountAmount.
  totalAmount       Decimal         @default(0) @db.Decimal(14, 2)
  reason            String?         @db.VarChar(500)
  approvedAt        DateTime?       @db.Timestamptz(3)
  approvedBy        String?         @db.VarChar(100)
  /// Market returns: goods reached the factory, then passed QC.
  factoryReceivedAt DateTime?       @db.Timestamptz(3)
  factoryReceivedBy String?         @db.VarChar(100)
  qcAt              DateTime?       @db.Timestamptz(3)
  qcBy              String?         @db.VarChar(100)
  deletedAt         DateTime?       @db.Timestamptz(3)
  deletedBy         String?         @db.VarChar(100)
  deleteReason      String?         @db.VarChar(500)
  updatedBy         String?         @db.VarChar(100)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  businessUnit     BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesPerson      SalesPerson?      @relation(fields: [salesPersonId], references: [id], onDelete: Restrict)
  delivery         SalesDelivery?    @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  office           Office?           @relation(fields: [officeId], references: [id], onDelete: Restrict)
  warehouse        Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  exchangeDelivery SalesDelivery?    @relation("ExchangeReturn")
  lines            SalesReturnLine[]

  @@unique([businessUnitId, number])
  @@index([businessUnitId, status, returnDate])
  @@index([customerId, status])
  @@index([deliveryId])
  @@map("sales_returns")
}

model SalesReturnLine {
  id             String   @id @default(uuid()) @db.Uuid
  returnId       String   @db.Uuid
  lineNo         Int
  itemId         String   @db.Uuid
  /// The delivery line returned (FULL / PARTIAL returns).
  deliveryLineId String?  @db.Uuid
  uom            String?  @db.VarChar(20)
  qty            Decimal  @db.Decimal(14, 3)
  /// Return price per unit as entered (VAT-inclusive when the return says so).
  rate           Decimal  @db.Decimal(14, 2)
  vatPercent     Decimal  @default(0) @db.Decimal(5, 2)
  baseAmount     Decimal  @default(0) @db.Decimal(14, 2)
  vatAmount      Decimal  @default(0) @db.Decimal(14, 2)
  aitAmount      Decimal  @default(0) @db.Decimal(14, 2)
  /// Line total (VAT/AIT included).
  amount         Decimal  @db.Decimal(14, 2)
  reason         String?  @db.VarChar(100)
  /// Market returns: quantity the factory received, and how much passed QC.
  receivedQty    Decimal? @db.Decimal(14, 3)
  qcQty          Decimal? @db.Decimal(14, 3)

  salesReturn  SalesReturn        @relation(fields: [returnId], references: [id], onDelete: Cascade)
  item         Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  deliveryLine SalesDeliveryLine? @relation(fields: [deliveryLineId], references: [id], onDelete: Restrict)

  @@unique([returnId, lineNo])
  @@index([itemId])
  @@index([deliveryLineId])
  @@map("sales_return_lines")
}

enum SalesReturnKind {
  /// Goods back into a warehouse.
  SALES
  /// Collected from the market; the factory receives and QC-checks it.
  MARKET
}

enum SalesReturnMode {
  FULL
  PARTIAL
  WITHOUT_REFERENCE
  /// Goods taken back on an exchange delivery.
  EXCHANGE
}

/// Why goods come back (damaged, expired, good product …).
model SalesReturnReason {
  id             String   @id @default(uuid()) @db.Uuid
  businessUnitId String   @db.Uuid
  name           String   @db.VarChar(100)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)

  @@unique([businessUnitId, name])
  @@map("sales_return_reasons")
}

/// Payment received from a customer against their receivable.
model SalesCollection {
  id             String           @id @default(uuid()) @db.Uuid
  businessUnitId String           @db.Uuid
  number         String           @db.VarChar(30)
  customerId     String           @db.Uuid
  salesPersonId  String?          @db.Uuid
  collectionDate DateTime         @db.Date
  method         CollectionMethod @default(CASH)
  amount         Decimal          @db.Decimal(14, 2)
  reference      String?          @db.VarChar(100)
  status         SalesDocStatus   @default(DRAFT)
  remarks        String?          @db.VarChar(500)
  /// Set when the money was collected on a delivery.
  deliveryId     String?          @db.Uuid
  /// INVOICE: settles invoices (allocations). ADVANCE: on account, adjusted later.
  kind           CollectionKind   @default(INVOICE)
  officeId       String?          @db.Uuid
  bankName       String?          @db.VarChar(100)
  /// Money Receipt No (Due Collection).
  moneyReceiptNo String?          @db.VarChar(60)
  /// Cash Type on Due Collection (e.g. Cash in Hand, Petty Cash).
  cashType       String?          @db.VarChar(30)
  /// "Adjust With GL": the GL the collection is posted against.
  adjustAccountId String?         @db.Uuid
  /// Advance Collection voucher: Cash / Bank Receive, cash account, project, narration.
  voucherType    String?          @db.VarChar(30)
  cashAccountId  String?          @db.Uuid
  cashRemarks    String?          @db.VarChar(300)
  project        String?          @db.VarChar(150)
  narration      String?          @db.VarChar(500)
  controlAmount  Decimal?         @db.Decimal(14, 2)
  /// Advance row: part of the amount adjusted at once.
  adjustmentAmount Decimal        @default(0) @db.Decimal(14, 2)
  /// Advance taken against a sales order (SO No).
  salesOrderId   String?          @db.Uuid
  /// Employee who took the advance.
  employeeId     String?          @db.Uuid
  /// Bank charges deducted from the money received (sum of deductions).
  deductionAmount Decimal         @default(0) @db.Decimal(14, 2)
  createdBy      String?          @db.VarChar(100)
  cancelledAt    DateTime?        @db.Timestamptz(3)
  cancelledBy    String?          @db.VarChar(100)
  cancelReason   String?          @db.VarChar(500)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit                @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  customer     Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesPerson  SalesPerson?                @relation(fields: [salesPersonId], references: [id], onDelete: Restrict)
  delivery     SalesDelivery?              @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  office       Office?                     @relation(fields: [officeId], references: [id], onDelete: Restrict)
  adjustAccount Account?                   @relation("CollectionAdjustAccount", fields: [adjustAccountId], references: [id], onDelete: SetNull)
  cashAccount   Account?                   @relation("CollectionCashAccount", fields: [cashAccountId], references: [id], onDelete: SetNull)
  salesOrder    SalesOrder?                @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  employee      Employee?                  @relation("CollectionEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  allocations  SalesCollectionAllocation[]
  deductions   SalesCollectionDeduction[]

  @@unique([businessUnitId, number])
  @@index([businessUnitId, status, collectionDate])
  @@index([customerId, status])
  @@map("sales_collections")
}

/// Monthly sales target for one sales person.
/// One month of a sales force's budget target (see SalesTargetBudget).
model SalesTarget {
  id             String   @id @default(uuid()) @db.Uuid
  businessUnitId String   @db.Uuid
  budgetId       String   @db.Uuid
  salesPersonId  String   @db.Uuid
  /// First day of the target month.
  month          DateTime @db.Date
  /// Target value in taka (AMOUNT budgets; 0 for QUANTITY budgets).
  amount         Decimal  @db.Decimal(14, 2)
  /// Target quantity (QUANTITY budgets).
  qty            Decimal? @db.Decimal(14, 3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  budget       SalesTargetBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  salesPerson  SalesPerson       @relation(fields: [salesPersonId], references: [id], onDelete: Cascade)

  @@unique([budgetId, salesPersonId, month])
  @@index([businessUnitId, month])
  @@index([salesPersonId, month])
  @@map("sales_targets")
}

enum TargetBasis {
  AMOUNT
  QUANTITY
}

enum CommissionBasis {
  /// Taka per unit sold (commission setup) or a fixed sum (target assignment).
  AMOUNT
  /// Percent of the sales value.
  PERCENT
}

/// "Target" tab: a year's monthly targets for the sales force, in taka or quantity.
model SalesTargetBudget {
  id             String      @id @default(uuid()) @db.Uuid
  businessUnitId String      @db.Uuid
  /// Who the targets are for (Employee = sales force).
  targetType     String      @default("EMPLOYEE") @db.VarChar(20)
  basis          TargetBasis
  year           Int
  createdBy      String?     @db.VarChar(100)
  updatedBy      String?     @db.VarChar(100)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit  @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  lines        SalesTarget[]

  @@unique([businessUnitId, year, basis])
  @@map("sales_target_budgets")
}

/// "Sales Target" tab: a named target for a period, with its customers / items.
/// SUBMITTED = live, CANCELLED = deleted.
model SalesTargetPlan {
  id                String         @id @default(uuid()) @db.Uuid
  businessUnitId    String         @db.Uuid
  number            String         @db.VarChar(30)
  officeId          String         @db.Uuid
  createDate        DateTime       @db.Date
  basis             TargetBasis
  name              String         @db.VarChar(150)
  targetAmount      Decimal        @db.Decimal(14, 2)
  startDate         DateTime       @db.Date
  endDate           DateTime       @db.Date
  remarks           String?        @db.VarChar(500)
  /// Lines name customer groups instead of customers.
  customerGroupWise Boolean        @default(false)
  status            SalesDocStatus @default(SUBMITTED)
  createdBy         String?        @db.VarChar(100)
  updatedBy         String?        @db.VarChar(100)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit            @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  office       Office                  @relation(fields: [officeId], references: [id], onDelete: Restrict)
  lines        SalesTargetPlanLine[]
  assignments  SalesTargetAssignment[]

  @@unique([businessUnitId, number])
  @@index([officeId, startDate])
  @@map("sales_target_plans")
}

model SalesTargetPlanLine {
  id              String   @id @default(uuid()) @db.Uuid
  planId          String   @db.Uuid
  lineNo          Int
  customerId      String?  @db.Uuid
  customerGroupId String?  @db.Uuid
  itemId          String?  @db.Uuid
  rate            Decimal? @db.Decimal(14, 2)
  qty             Decimal? @db.Decimal(14, 3)
  amount          Decimal  @db.Decimal(14, 2)

  plan          SalesTargetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerGroup CustomerGroup?  @relation(fields: [customerGroupId], references: [id], onDelete: Restrict)
  item          Item?           @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([planId, lineNo])
  @@map("sales_target_plan_lines")
}

/// A sales force's share of a target plan, with its commission.
model SalesTargetAssignment {
  id                String          @id @default(uuid()) @db.Uuid
  planId            String          @db.Uuid
  salesPersonId     String          @db.Uuid
  customerGroupId   String?         @db.Uuid
  targetAmount      Decimal         @db.Decimal(14, 2)
  commissionBasis   CommissionBasis
  commissionRate    Decimal         @db.Decimal(14, 4)
  /// Commission is earned only if collections reach this.
  minimumCollection Decimal         @db.Decimal(14, 2)
  createdBy         String?         @db.VarChar(100)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  plan          SalesTargetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  salesPerson   SalesPerson     @relation(fields: [salesPersonId], references: [id], onDelete: Restrict)
  customerGroup CustomerGroup?  @relation(fields: [customerGroupId], references: [id], onDelete: Restrict)

  @@unique([planId, salesPersonId])
  @@index([salesPersonId])
  @@map("sales_target_assignments")
}

/// "Commission Setup": item commission of a sales force for a period.
/// SUBMITTED = live, CANCELLED = deleted.
model SalesCommission {
  id              String         @id @default(uuid()) @db.Uuid
  businessUnitId  String         @db.Uuid
  name            String         @db.VarChar(150)
  salesPersonId   String         @db.Uuid
  /// Only sales to customers of this group earn it (null = all customers).
  customerGroupId String?        @db.Uuid
  fromDate        DateTime       @db.Date
  toDate          DateTime       @db.Date
  status          SalesDocStatus @default(SUBMITTED)
  createdBy       String?        @db.VarChar(100)
  updatedBy       String?        @db.VarChar(100)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  businessUnit  BusinessUnit          @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  salesPerson   SalesPerson           @relation(fields: [salesPersonId], references: [id], onDelete: Restrict)
  customerGroup CustomerGroup?        @relation(fields: [customerGroupId], references: [id], onDelete: Restrict)
  lines         SalesCommissionLine[]

  @@index([salesPersonId, fromDate])
  @@map("sales_commissions")
}

model SalesCommissionLine {
  id           String          @id @default(uuid()) @db.Uuid
  commissionId String          @db.Uuid
  itemId       String          @db.Uuid
  basis        CommissionBasis
  /// Taka per unit (AMOUNT) or percent of the line value (PERCENT).
  value        Decimal         @db.Decimal(14, 4)

  commission SalesCommission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  item       Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([commissionId, itemId])
  @@index([itemId])
  @@map("sales_commission_lines")
}

/// Last number issued per business unit, document type and year. Incremented
/// atomically when a document is created, so numbers never repeat.
model DocumentSequence {
  businessUnitId String   @db.Uuid
  /// e.g. "SALES_QUOTATION", "CUSTOMER".
  docType        String   @db.VarChar(40)
  /// Calendar year, or 0 for sequences that never reset (masters).
  year           Int
  lastNumber     Int
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@id([businessUnitId, docType, year])
  @@map("document_sequences")
}

/// ERPNext quotation statuses. "Expired" is derived (SUBMITTED past validTill).
enum QuotationStatus {
  DRAFT
  SUBMITTED
  ORDERED
  LOST
  CANCELLED
}

/// Price offer to a customer. Amounts are computed by the server from the lines.
model SalesQuotation {
  id             String          @id @default(uuid()) @db.Uuid
  businessUnitId String          @db.Uuid
  officeId       String          @db.Uuid
  number         String          @db.VarChar(30)
  customerId     String          @db.Uuid
  salesPersonId  String?         @db.Uuid
  quotationDate  DateTime        @db.Date
  validTill      DateTime        @db.Date
  status         QuotationStatus @default(DRAFT)
  /// Customer's mobile at the time of the quotation (editable per document).
  contactMobile  String?         @db.VarChar(30)
  billingAddress       String?   @db.VarChar(500)
  billingContactPerson String?   @db.VarChar(150)
  billingContactNo     String?   @db.VarChar(30)
  reference            String?   @db.VarChar(150)
  subject              String?   @db.VarChar(300)
  quotationType        String    @default("Quotation") @db.VarChar(30)
  /// Unit prices include VAT (VAT is taken out of them instead of added).
  includingVat         Boolean   @default(false)
  /// Rich text (editor JSON document) shown above and below the items.
  remarksBody          Json?
  remarksFooter        Json?
  /// Numbered terms: [{ text, optional }].
  termsList            Json?
  totalQty       Decimal         @default(0) @db.Decimal(14, 3)
  /// Sum of qty × rate before discounts.
  subTotal       Decimal         @default(0) @db.Decimal(14, 2)
  /// Sum of the line discounts.
  discountAmount Decimal         @default(0) @db.Decimal(14, 2)
  vatAmount      Decimal         @default(0) @db.Decimal(14, 2)
  aitAmount      Decimal         @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal         @default(0) @db.Decimal(14, 2)
  /// Reject reason (status LOST).
  lostReason     String?         @db.VarChar(500)
  /// Approved (status SUBMITTED) by and when.
  approvedBy     String?         @db.VarChar(100)
  submittedAt    DateTime?       @db.Timestamptz(3)
  cancelledAt    DateTime?       @db.Timestamptz(3)
  createdBy      String          @db.VarChar(100)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit         @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  office       Office               @relation(fields: [officeId], references: [id], onDelete: Restrict)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesPerson  SalesPerson?         @relation(fields: [salesPersonId], references: [id], onDelete: Restrict)
  lines        SalesQuotationLine[]
  salesOrders  SalesOrder[]

  @@unique([businessUnitId, number])
  @@index([businessUnitId, quotationDate])
  @@index([officeId, status, quotationDate])
  @@index([customerId])
  @@map("sales_quotations")
}

model SalesQuotationLine {
  id              String  @id @default(uuid()) @db.Uuid
  quotationId     String  @db.Uuid
  lineNo          Int
  itemId          String  @db.Uuid
  description     String? @db.VarChar(500)
  uom             String  @db.VarChar(20)
  qty             Decimal @db.Decimal(14, 3)
  rate            Decimal @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal @default(0) @db.Decimal(14, 2)
  vatPercent      Decimal @default(0) @db.Decimal(5, 2)
  vatAmount       Decimal @default(0) @db.Decimal(14, 2)
  aitPercent      Decimal @default(0) @db.Decimal(5, 2)
  aitAmount       Decimal @default(0) @db.Decimal(14, 2)
  /// Line total: (qty × rate − discount) + VAT (unless prices include it) + AIT.
  amount          Decimal @db.Decimal(14, 2)
  warranty        String? @db.VarChar(100)
  deliveryDate    DateTime? @db.Date

  quotation SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  item      Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([quotationId, lineNo])
  @@index([itemId])
  @@map("sales_quotation_lines")
}

// ─── Sales › Setup masters ───────────────────────────────────────────────────

enum CustomerType {
  GENERAL
  DEALER
  DISTRIBUTOR
  RETAILER
  CORPORATE
}

/// Geographic sales areas. One table for all four levels keeps setup simple.
enum SalesAreaKind {
  ZONE
  TERRITORY
  ROUTE
  SECTION
}

model SalesArea {
  id             String        @id @default(uuid()) @db.Uuid
  businessUnitId String        @db.Uuid
  kind           SalesAreaKind
  name           String        @db.VarChar(100)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  businessUnit       BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  zoneCustomers      Customer[]   @relation("CustomerZone")
  territoryCustomers Customer[]   @relation("CustomerTerritory")
  routeCustomers     Customer[]   @relation("CustomerRoute")
  sectionCustomers   Customer[]   @relation("CustomerSection")
  sectionAddresses   CustomerAddress[] @relation("CustomerAddressSection")
  territoryNode      SalesTerritoryNode?

  @@unique([businessUnitId, kind, name])
  @@map("sales_areas")
}

model CustomerGroup {
  id             String   @id @default(uuid()) @db.Uuid
  businessUnitId String   @db.Uuid
  name           String   @db.VarChar(100)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  /// Set for a Sub Group (Customer Profile).
  parentId       String?  @db.Uuid

  businessUnit      BusinessUnit    @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  parent            CustomerGroup?  @relation("CustomerGroupTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          CustomerGroup[] @relation("CustomerGroupTree")
  customers         Customer[]
  subGroupCustomers Customer[]      @relation("CustomerSubGroup")
  offers            SalesOffer[]            @relation("OfferCustomerGroup")
  offerSpecialLines SalesOfferSpecialLine[] @relation("OfferSpecialGroup")
  groupPriceSetups  CustomerGroupPriceSetup[]
  targetPlanLines   SalesTargetPlanLine[]
  targetAssignments SalesTargetAssignment[]
  commissions       SalesCommission[]

  @@unique([businessUnitId, name])
  @@map("customer_groups")
}

/// Ship-to / billing addresses of a customer.
model CustomerAddress {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  label      String   @db.VarChar(60)
  address    String   @db.VarChar(500)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  // Shipping Details of the Customer Profile (label = Ref/Outlet).
  code          String?  @db.VarChar(30)
  gps           String?  @db.VarChar(100)
  contactPerson String?  @db.VarChar(150)
  contactNo     String?  @db.VarChar(30)
  vatRegNo      String?  @db.VarChar(50)
  districtId    Int?
  thanaId       String?  @db.Uuid
  sectionId     String?  @db.Uuid
  sortOrder     Int      @default(0)

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesOrders SalesOrder[]
  deliveries  SalesDelivery[]
  district    District?    @relation(fields: [districtId], references: [id], onDelete: SetNull)
  thana       Thana?       @relation(fields: [thanaId], references: [id], onDelete: SetNull)
  section     SalesArea?   @relation("CustomerAddressSection", fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @db.Uuid
  storageKey   String   @unique @db.VarChar(300)
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  size         Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_attachments")
}

/// Item category tree: level 1 Category › 2 Sub Category › 3 Minor Category.
model ItemCategory {
  id             String   @id @default(uuid()) @db.Uuid
  businessUnitId String   @db.Uuid
  parentId       String?  @db.Uuid
  level          Int
  name           String   @db.VarChar(100)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  description    String?  @db.VarChar(300)

  businessUnit BusinessUnit   @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  parent       ItemCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     ItemCategory[] @relation("CategoryTree")
  items        Item[]
  offers         SalesOffer[]         @relation("OfferCategory")
  offerPairLines SalesOfferPairLine[] @relation("OfferPairCategory")

  @@unique([businessUnitId, parentId, name])
  @@map("item_categories")
}

/// Item Division of the Item Profile ("+ Add" from the form).
model ItemDivision {
  id             String   @id @default(uuid()) @db.Uuid
  businessUnitId String   @db.Uuid
  name           String   @db.VarChar(100)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  items        Item[]

  @@unique([businessUnitId, name])
  @@map("item_divisions")
}

/// Units of measure offered in the Item Profile (UOM, Alt. UOM, Net Weight Unit).
model ItemUom {
  id             String   @id @default(uuid()) @db.Uuid
  businessUnitId String   @db.Uuid
  name           String   @db.VarChar(20)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)

  @@unique([businessUnitId, name])
  @@map("item_uoms")
}

/// Opening stock received into a warehouse (Item Profile "Opening Stock").
model OpeningStockReceipt {
  id                String   @id @default(uuid()) @db.Uuid
  businessUnitId    String   @db.Uuid
  number            String   @db.VarChar(30)
  receiptDate       DateTime @db.Date
  officeId          String   @db.Uuid
  warehouseId       String   @db.Uuid
  /// INVENTORY or ASSET.
  itemType          String   @db.VarChar(20)
  challanNo         String?  @db.VarChar(50)
  remarks           String?  @db.VarChar(500)
  /// Credit GL account, copied from the chart of accounts when saved.
  creditAccountCode String?  @db.VarChar(30)
  creditAccountName String?  @db.VarChar(200)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  businessUnit BusinessUnit       @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  office       Office             @relation(fields: [officeId], references: [id], onDelete: Restrict)
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines        OpeningStockLine[]

  @@unique([businessUnitId, number])
  @@map("opening_stock_receipts")
}

model OpeningStockLine {
  id        String  @id @default(uuid()) @db.Uuid
  receiptId String  @db.Uuid
  sortOrder Int
  itemId    String  @db.Uuid
  quantity  Decimal @db.Decimal(14, 3)
  rate      Decimal @db.Decimal(14, 2)
  amount    Decimal @db.Decimal(16, 2)

  receipt OpeningStockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item    Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([itemId])
  @@map("opening_stock_lines")
}

/// Price type (Dealer Price, Retail Price …) with a rate per item.
model PriceList {
  id             String   @id @default(uuid()) @db.Uuid
  businessUnitId String   @db.Uuid
  name           String   @db.VarChar(100)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  prices       ItemPrice[]
  salesOrders  SalesOrder[]
  customers    Customer[]
  offers       SalesOffer[]
  customerPriceSetups CustomerPriceSetup[]
  groupPriceSetups    CustomerGroupPriceSetup[]

  @@unique([businessUnitId, name])
  @@map("price_lists")
}

// ─── Configuration › Sales Config › Offer Setup ─────────────────────────────

/// A sales offer. `kind`: ITEM (buy item, get item), ITEM_MULTIPLE (buy a
/// combination, get bonus items), DISCOUNT (item discounts) or SPECIAL_DISCOUNT
/// (invoice-amount slabs).
model SalesOffer {
  id              String    @id @default(uuid()) @db.Uuid
  businessUnitId  String    @db.Uuid
  kind            String    @db.VarChar(20)
  name            String    @db.VarChar(150)
  fromDate        DateTime? @db.Date
  toDate          DateTime? @db.Date
  customerGroupId String?   @db.Uuid
  priceListId     String?   @db.Uuid
  basedOn         String?   @db.VarChar(30)
  /// Selling item category filter (the most specific level chosen).
  categoryId      String?   @db.Uuid
  remarks         String?   @db.VarChar(500)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  businessUnit  BusinessUnit   @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  customerGroup CustomerGroup? @relation("OfferCustomerGroup", fields: [customerGroupId], references: [id], onDelete: SetNull)
  priceList     PriceList?     @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  category      ItemCategory?  @relation("OfferCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  itemLines     SalesOfferItemLine[]
  pairLines     SalesOfferPairLine[]
  bonusLines    SalesOfferBonusLine[]
  discountLines SalesOfferDiscountLine[]
  specialLines  SalesOfferSpecialLine[]

  @@index([businessUnitId, kind])
  @@map("sales_offers")
}

// ─── Configuration › Sales Config › Sales Setup (territory tree) ────────────

/// Levels of the sales territory tree (National, Region, Territory …) per business unit.
model SalesTerritoryLayer {
  id             String   @id @default(uuid()) @db.Uuid
  businessUnitId String   @db.Uuid
  level          Int
  code           String   @db.VarChar(20)
  name           String   @db.VarChar(50)
  /// The layer whose nodes are the Sales territories customers use.
  isTerritory    Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  businessUnit BusinessUnit         @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  nodes        SalesTerritoryNode[]

  @@unique([businessUnitId, level])
  @@unique([businessUnitId, code])
  @@map("sales_territory_layers")
}

model SalesTerritoryNode {
  id             String   @id @default(uuid()) @db.Uuid
  businessUnitId String   @db.Uuid
  layerId        String   @db.Uuid
  parentId       String?  @db.Uuid
  code           String   @db.VarChar(30)
  name           String   @db.VarChar(100)
  /// Set on Territory-layer nodes: the linked Sales territory.
  salesAreaId    String?  @unique @db.Uuid
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit             @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  layer        SalesTerritoryLayer      @relation(fields: [layerId], references: [id], onDelete: Restrict)
  parent       SalesTerritoryNode?      @relation("TerritoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     SalesTerritoryNode[]     @relation("TerritoryTree")
  salesArea    SalesArea?               @relation(fields: [salesAreaId], references: [id], onDelete: SetNull)
  employees    SalesTerritoryEmployee[]

  @@unique([businessUnitId, code])
  @@index([parentId])
  @@map("sales_territory_nodes")
}

/// Employees assigned to a territory node.
model SalesTerritoryEmployee {
  id                  String   @id @default(uuid()) @db.Uuid
  nodeId              String   @db.Uuid
  employeeId          String   @db.Uuid
  distributionChannel String?  @db.VarChar(100)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  node     SalesTerritoryNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, employeeId])
  @@map("sales_territory_employees")
}

// ─── Configuration › Sales Config › Customer Price Setup ────────────────────

/// Customer-specific DP/TP prices (one setup per customer and price type).
model CustomerPriceSetup {
  id             String   @id @default(uuid()) @db.Uuid
  businessUnitId String   @db.Uuid
  customerId     String   @db.Uuid
  priceListId    String?  @db.Uuid
  /// Item filter used when the setup was built (for reference).
  itemType       String?  @db.VarChar(30)
  categoryId     String?  @db.Uuid
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit        @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  priceList    PriceList?          @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  lines        CustomerPriceLine[]

  @@index([businessUnitId])
  @@index([customerId])
  @@map("customer_price_setups")
}

model CustomerPriceLine {
  id        String  @id @default(uuid()) @db.Uuid
  setupId   String  @db.Uuid
  sortOrder Int
  itemId    String  @db.Uuid
  dpPrice   Decimal @db.Decimal(14, 2)
  tpPrice   Decimal @db.Decimal(14, 2)

  setup CustomerPriceSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)
  item  Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([setupId, itemId])
  @@map("customer_price_lines")
}

/// Customer-group DP/TP prices by date and quantity range ("Customer Offer" tab).
model CustomerGroupPriceSetup {
  id              String   @id @default(uuid()) @db.Uuid
  businessUnitId  String   @db.Uuid
  officeId        String   @db.Uuid
  customerGroupId String   @db.Uuid
  priceListId     String?  @db.Uuid
  createDate      DateTime @db.Date
  circularNo      String?  @db.VarChar(100)
  remarks         String?  @db.VarChar(500)
  isRunning       Boolean  @default(true)
  itemType        String?  @db.VarChar(30)
  categoryId      String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  businessUnit  BusinessUnit             @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  office        Office                   @relation(fields: [officeId], references: [id], onDelete: Restrict)
  customerGroup CustomerGroup            @relation(fields: [customerGroupId], references: [id], onDelete: Restrict)
  priceList     PriceList?               @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  lines         CustomerGroupPriceLine[]

  @@index([businessUnitId])
  @@map("customer_group_price_setups")
}

model CustomerGroupPriceLine {
  id        String    @id @default(uuid()) @db.Uuid
  setupId   String    @db.Uuid
  sortOrder Int
  itemId    String    @db.Uuid
  fromDate  DateTime? @db.Date
  toDate    DateTime? @db.Date
  fromQty   Decimal?  @db.Decimal(14, 3)
  toQty     Decimal?  @db.Decimal(14, 3)
  dpPrice   Decimal   @db.Decimal(14, 2)
  tpPrice   Decimal   @db.Decimal(14, 2)

  setup CustomerGroupPriceSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)
  item  Item                    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([setupId])
  @@map("customer_group_price_lines")
}

// ─── Configuration › Sales Config › Standard Price Setup ─────────────────────

/// Dated standard price of an item; the latest `effectiveFrom` is the current one.
/// `increaseType` PERCENT or AMOUNT applies `increaseValue` to `costPrice` (→ ETP).
model StandardPrice {
  id             String   @id @default(uuid()) @db.Uuid
  businessUnitId String   @db.Uuid
  itemId         String   @db.Uuid
  effectiveFrom  DateTime @db.Date
  costPrice      Decimal? @db.Decimal(14, 2)
  increaseType   String   @default("PERCENT") @db.VarChar(10)
  increaseValue  Decimal? @db.Decimal(14, 2)
  etpPrice       Decimal? @db.Decimal(14, 2)
  dealerPrice    Decimal? @db.Decimal(14, 2)
  tradingPrice   Decimal? @db.Decimal(14, 2)
  mrp            Decimal? @db.Decimal(14, 2)
  minSalesPrice  Decimal? @db.Decimal(14, 2)
  remarks        String?  @db.VarChar(300)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, effectiveFrom])
  @@index([businessUnitId])
  @@map("standard_prices")
}

// ─── Configuration › Sales Config › Sales Return Price Setup ─────────────────

/// Dated return rates of an item; the latest `effectiveFrom` is the current one.
model SalesReturnPrice {
  id                String   @id @default(uuid()) @db.Uuid
  businessUnitId    String   @db.Uuid
  itemId            String   @db.Uuid
  effectiveFrom     DateTime @db.Date
  damageRate        Decimal  @default(0) @db.Decimal(14, 2)
  expireRate        Decimal  @default(0) @db.Decimal(14, 2)
  damageExpireRate  Decimal  @default(0) @db.Decimal(14, 2)
  soundStockRate    Decimal  @default(0) @db.Decimal(14, 2)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, effectiveFrom])
  @@index([businessUnitId])
  @@map("sales_return_prices")
}

// ─── Configuration › Sales Config › Wallet Setup ─────────────────────────────

/// A payment wallet (cash, bank or MFS) used when collecting sales payments.
/// Non-cash wallets settle into `bankAccountId`. One optional attachment.
model SalesWallet {
  id                  String   @id @default(uuid()) @db.Uuid
  businessUnitId      String   @db.Uuid
  name                String   @db.VarChar(100)
  commissionPercent   Decimal  @db.Decimal(5, 2)
  isCash              Boolean  @default(false)
  bankAccountId       String?  @db.Uuid
  officeId            String?  @db.Uuid
  referenceCode       String?  @db.VarChar(50)
  isRounding          Boolean  @default(false)
  isCoupon            Boolean  @default(false)
  isWalletCharge      Boolean  @default(false)
  isReferenceRequired Boolean  @default(false)
  isMfs               Boolean  @default(false)
  isActive            Boolean  @default(true)
  attachmentKey       String?  @unique @db.VarChar(300)
  attachmentName      String?  @db.VarChar(255)
  attachmentType      String?  @db.VarChar(100)
  attachmentSize      Int?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  bankAccount  BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  office       Office?      @relation(fields: [officeId], references: [id], onDelete: SetNull)

  @@unique([businessUnitId, name])
  @@index([bankAccountId])
  @@map("sales_wallets")
}

/// Items tab: buy the selling item, get the offer item.
model SalesOfferItemLine {
  id            String  @id @default(uuid()) @db.Uuid
  offerId       String  @db.Uuid
  sortOrder     Int
  sellingItemId String  @db.Uuid
  sellingUom    String  @db.VarChar(20)
  sellingQty    Decimal @db.Decimal(14, 3)
  offerItemId   String  @db.Uuid
  offerUom      String  @db.VarChar(20)
  offerQty      Decimal @db.Decimal(14, 3)

  offer       SalesOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sellingItem Item       @relation("OfferSellingItem", fields: [sellingItemId], references: [id], onDelete: Restrict)
  offerItem   Item       @relation("OfferFreeItem", fields: [offerItemId], references: [id], onDelete: Restrict)

  @@index([offerId])
  @@map("sales_offer_item_lines")
}

/// Item (Multiple) tab: the selling items that must be bought together.
model SalesOfferPairLine {
  id         String   @id @default(uuid()) @db.Uuid
  offerId    String   @db.Uuid
  sortOrder  Int
  /// Item (Multiple): the pair this selling condition belongs to (1, 2, …).
  pairNo     Int      @default(1)
  categoryId String?  @db.Uuid
  /// Null = every item of the category ("All").
  itemId     String?  @db.Uuid
  quantity   Decimal  @db.Decimal(14, 3)
  minQty     Decimal? @db.Decimal(14, 3)
  maxQty     Decimal? @db.Decimal(14, 3)

  offer    SalesOffer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  category ItemCategory? @relation("OfferPairCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  item     Item?         @relation("OfferPairItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@index([offerId])
  @@map("sales_offer_pair_lines")
}

/// Item (Multiple) tab: bonus items given for the combination.
model SalesOfferBonusLine {
  id        String  @id @default(uuid()) @db.Uuid
  offerId   String  @db.Uuid
  sortOrder Int
  /// Item (Multiple): the pair whose selling condition earns this bonus.
  pairNo    Int     @default(1)
  itemId    String  @db.Uuid
  quantity  Decimal @db.Decimal(14, 3)

  offer SalesOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  item  Item       @relation("OfferBonusItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@index([offerId])
  @@map("sales_offer_bonus_lines")
}

/// Discount tab: per-item discount.
model SalesOfferDiscountLine {
  id                   String   @id @default(uuid()) @db.Uuid
  offerId              String   @db.Uuid
  sortOrder            Int
  itemId               String   @db.Uuid
  /// PERCENT or FLAT.
  discountType         String   @db.VarChar(10)
  amount               Decimal  @db.Decimal(14, 2)
  quantity             Decimal? @db.Decimal(14, 3)
  minQty               Decimal? @db.Decimal(14, 3)
  maxQty               Decimal? @db.Decimal(14, 3)
  isRecurrent          Boolean  @default(false)
  supplierId           String?  @db.Uuid
  supplierContribution Decimal? @db.Decimal(5, 2)
  internalContribution Decimal? @db.Decimal(5, 2)

  offer    SalesOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  item     Item       @relation("OfferDiscountItem", fields: [itemId], references: [id], onDelete: Restrict)
  supplier Supplier?  @relation("OfferDiscountSupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([offerId])
  @@map("sales_offer_discount_lines")
}

/// Special Discount tab: discount slabs by invoice amount.
model SalesOfferSpecialLine {
  id                   String   @id @default(uuid()) @db.Uuid
  offerId              String   @db.Uuid
  sortOrder            Int
  customerGroupId      String?  @db.Uuid
  /// PERCENT or FLAT.
  discountType         String   @db.VarChar(10)
  amount               Decimal  @db.Decimal(14, 2)
  fromAmount           Decimal? @db.Decimal(16, 2)
  toAmount             Decimal? @db.Decimal(16, 2)
  supplierId           String?  @db.Uuid
  supplierContribution Decimal? @db.Decimal(5, 2)
  internalContribution Decimal? @db.Decimal(5, 2)
  /// True: VAT on the discounted price; false: VAT on the original price.
  vatOnDiscounted      Boolean  @default(true)

  offer         SalesOffer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  customerGroup CustomerGroup? @relation("OfferSpecialGroup", fields: [customerGroupId], references: [id], onDelete: SetNull)
  supplier      Supplier?      @relation("OfferSpecialSupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([offerId])
  @@map("sales_offer_special_lines")
}

model ItemPrice {
  priceListId String   @db.Uuid
  itemId      String   @db.Uuid
  rate        Decimal  @db.Decimal(14, 2)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([priceListId, itemId])
  @@index([itemId])
  @@map("item_prices")
}

// ─── Sales › Sales Order ─────────────────────────────────────────────────────

/// DRAFT → (submit) → APPROVED, or PENDING_APPROVAL when a credit rule holds it.
/// APPROVED orders wait for delivery ("Pending" in the list) until COMPLETED.
enum SalesOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  COMPLETED
  CANCELLED
}

enum SalesOrderType {
  SALES
  SAMPLE
  EXPORT
}

enum PaymentMethod {
  CASH
  CREDIT
  BANK
  CHEQUE
  MOBILE_BANKING
}

/// Why a submitted order waits for approval.
enum OrderHoldReason {
  CREDIT_LIMIT_EXCEEDED
  OVERDUE_BALANCE
}

model SalesOrder {
  id                      String           @id @default(uuid()) @db.Uuid
  businessUnitId          String           @db.Uuid
  officeId                String           @db.Uuid
  number                  String           @db.VarChar(30)
  customerId              String           @db.Uuid
  salesPersonId           String?          @db.Uuid
  quotationId             String?          @db.Uuid
  priceListId             String?          @db.Uuid
  shipToAddressId         String?          @db.Uuid
  orderType               SalesOrderType   @default(SALES)
  paymentMethod           PaymentMethod    @default(CASH)
  status                  SalesOrderStatus @default(DRAFT)
  holdReason              OrderHoldReason?
  orderDate               DateTime         @db.Date
  expectedDeliveryDate    DateTime         @db.Date
  priceIncludesVat        Boolean          @default(true)
  isForeign               Boolean          @default(false)
  /// Address text as it was when the order was saved.
  shippingAddress         String?          @db.VarChar(500)
  billingAddress          String?          @db.VarChar(500)
  contactPerson           String?          @db.VarChar(150)
  referredBy              String?          @db.VarChar(150)
  refCustomerPo           String?          @db.VarChar(60)
  refCustomerPoDate       DateTime?        @db.Date
  refCustomerPoAmount     Decimal?         @db.Decimal(14, 2)
  refInvoice              String?          @db.VarChar(60)
  refProjectOutlet        String?          @db.VarChar(150)
  paymentTermDays         Int              @default(0)
  dueLimit                Decimal          @default(0) @db.Decimal(14, 2)
  remarks                 String?          @db.VarChar(500)
  terms                   String?          @db.VarChar(4000)
  totalQty                Decimal          @default(0) @db.Decimal(14, 3)
  /// Sum of line totals (after line discounts, VAT/AIT included).
  itemsTotal              Decimal          @default(0) @db.Decimal(14, 2)
  /// Item value without VAT/AIT.
  itemsBase               Decimal          @default(0) @db.Decimal(14, 2)
  vatAmount               Decimal          @default(0) @db.Decimal(14, 2)
  aitAmount               Decimal          @default(0) @db.Decimal(14, 2)
  discountAmount          Decimal          @default(0) @db.Decimal(14, 2)
  deliveryCharge          Decimal          @default(0) @db.Decimal(14, 2)
  unloadingCharge         Decimal          @default(0) @db.Decimal(14, 2)
  salesTotal              Decimal          @default(0) @db.Decimal(14, 2)
  createdBy               String           @db.VarChar(100)
  updatedBy               String           @db.VarChar(100)
  submittedAt             DateTime?        @db.Timestamptz(3)
  approvedAt              DateTime?        @db.Timestamptz(3)
  closedAt                DateTime?        @db.Timestamptz(3)
  /// Why an approved order is not delivered yet (set from Sales Delivery).
  deliveryPendingReasonId String?          @db.Uuid
  createdAt               DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @db.Timestamptz(3)

  businessUnit          BusinessUnit           @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  office                Office                 @relation(fields: [officeId], references: [id], onDelete: Restrict)
  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesPerson           SalesPerson?           @relation(fields: [salesPersonId], references: [id], onDelete: Restrict)
  quotation             SalesQuotation?        @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  priceList             PriceList?             @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  shipTo                CustomerAddress?       @relation(fields: [shipToAddressId], references: [id], onDelete: SetNull)
  lines                 SalesOrderLine[]
  events                SalesOrderEvent[]
  deliveries            SalesDelivery[]
  deliveryPendingReason DeliveryPendingReason? @relation(fields: [deliveryPendingReasonId], references: [id], onDelete: SetNull)
  productionOrders ProductionOrder[]
  pendingNotes     SalesOrderPendingNote[]
  advanceCollections SalesCollection[]

  @@unique([businessUnitId, number])
  @@index([businessUnitId, orderDate])
  @@index([officeId, status, orderDate])
  @@index([customerId, status])
  @@index([quotationId])
  @@map("sales_orders")
}

/// Why an approved order is not delivered yet, each time someone records it ("Previous Pending Reason").
model SalesOrderPendingNote {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  reason    String   @db.VarChar(300)
  createdBy String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("sales_order_pending_notes")
}

model SalesOrderLine {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @db.Uuid
  lineNo          Int
  itemId          String   @db.Uuid
  uom             String   @db.VarChar(20)
  altUom          String?  @db.VarChar(20)
  altUomFactor    Decimal? @db.Decimal(14, 3)
  qty             Decimal  @db.Decimal(14, 3)
  /// Price as entered (VAT-inclusive when the order says so).
  unitPrice       Decimal  @db.Decimal(14, 4)
  mrp             Decimal? @db.Decimal(14, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  vatPercent      Decimal  @default(0) @db.Decimal(5, 2)
  aitPercent      Decimal  @default(0) @db.Decimal(5, 2)
  /// qty × unitPrice.
  grossAmount     Decimal  @db.Decimal(14, 2)
  /// After line discount, VAT/AIT included.
  lineTotal       Decimal  @db.Decimal(14, 2)
  baseAmount      Decimal  @db.Decimal(14, 2)
  vatAmount       Decimal  @db.Decimal(14, 2)
  aitAmount       Decimal  @db.Decimal(14, 2)
  /// Updated by Sales Delivery; remaining = qty − deliveredQty.
  deliveredQty    Decimal  @default(0) @db.Decimal(14, 3)

  order         SalesOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item          Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)
  deliveryLines SalesDeliveryLine[]

  @@unique([orderId, lineNo])
  @@index([itemId])
  @@map("sales_order_lines")
}

/// Audit trail and approval history of an order (the "Approval Status" tab).
model SalesOrderEvent {
  id         String            @id @default(uuid()) @db.Uuid
  orderId    String            @db.Uuid
  action     String            @db.VarChar(30)
  fromStatus SalesOrderStatus?
  toStatus   SalesOrderStatus
  remarks    String?           @db.VarChar(500)
  actorId    String            @db.VarChar(100)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("sales_order_events")
}

// ─── Sales › Delivery ────────────────────────────────────────────────────────

enum DeliveryType {
  /// Against an approved sales order.
  SALES_ORDER
  /// Without a sales order.
  DIRECT
  /// Replacement goods given against goods taken back.
  EXCHANGE
}

/// Logistics confirms that goods reached the customer; confirmed deliveries are locked.
enum DeliveryConfirmation {
  PENDING
  CONFIRMED
}

/// Why an approved order is waiting ("Pending Reason" on Approved SO).
model DeliveryPendingReason {
  id             String   @id @default(uuid()) @db.Uuid
  businessUnitId String   @db.Uuid
  name           String   @db.VarChar(100)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  orders       SalesOrder[]

  @@unique([businessUnitId, name])
  @@map("delivery_pending_reasons")
}

enum StockSource {
  OPENING
  ADJUSTMENT
  SALES_DELIVERY
  SALES_RETURN
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
}

/// Stock ledger: one signed quantity per movement. Stock = sum(qty) per
/// warehouse and item. Owned by Sales until the Stock module takes over.
model StockEntry {
  id             String      @id @default(uuid()) @db.Uuid
  businessUnitId String      @db.Uuid
  warehouseId    String      @db.Uuid
  itemId         String      @db.Uuid
  qty            Decimal     @db.Decimal(14, 3)
  source         StockSource
  /// Delivery / return id for document-driven movements.
  sourceId       String?     @db.Uuid
  postingDate    DateTime    @db.Date
  remarks        String?     @db.VarChar(500)
  createdBy      String      @db.VarChar(100)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([warehouseId, itemId])
  @@index([itemId])
  @@index([source, sourceId])
  @@map("stock_entries")
}

enum CollectionKind {
  INVOICE
  ADVANCE
}

/// Part of a collection applied to one invoice (delivery).
/// Bank Deduction Details of a collection: charges the bank kept (expense, GL, amount).
model SalesCollectionDeduction {
  id           String  @id @default(uuid()) @db.Uuid
  collectionId String  @db.Uuid
  expense      String  @db.VarChar(150)
  accountId    String  @db.Uuid
  amount       Decimal @db.Decimal(14, 2)

  collection SalesCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  account    Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([collectionId])
  @@map("sales_collection_deductions")
}

model SalesCollectionAllocation {
  id           String   @id @default(uuid()) @db.Uuid
  collectionId String   @db.Uuid
  deliveryId   String   @db.Uuid
  amount       Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  collection SalesCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  delivery   SalesDelivery   @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@unique([collectionId, deliveryId])
  @@index([deliveryId])
  @@map("sales_collection_allocations")
}

/// Due invoices of one customer gathered on a bill for collection.
/// SUBMITTED = live, CANCELLED = cancelled.
model SalesBill {
  id             String         @id @default(uuid()) @db.Uuid
  businessUnitId String         @db.Uuid
  number         String         @db.VarChar(30)
  officeId       String         @db.Uuid
  customerId     String         @db.Uuid
  billDate       DateTime       @db.Date
  status         SalesDocStatus @default(SUBMITTED)
  /// Sum of the invoices' dues when billed.
  totalAmount    Decimal        @default(0) @db.Decimal(14, 2)
  /// NORMAL bill or FACTORING bill (sold to a factoring company).
  billType       String         @default("NORMAL") @db.VarChar(20)
  terms          String?        @db.VarChar(4000)
  remarks        String?        @db.VarChar(500)
  createdBy      String?        @db.VarChar(100)
  cancelledAt    DateTime?      @db.Timestamptz(3)
  cancelledBy    String?        @db.VarChar(100)
  cancelReason   String?        @db.VarChar(500)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  businessUnit BusinessUnit    @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  office       Office          @relation(fields: [officeId], references: [id], onDelete: Restrict)
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines        SalesBillLine[]

  @@unique([businessUnitId, number])
  @@index([customerId, status])
  @@map("sales_bills")
}

model SalesBillLine {
  id         String  @id @default(uuid()) @db.Uuid
  billId     String  @db.Uuid
  deliveryId String  @db.Uuid
  /// The invoice's due when billed.
  amount     Decimal @db.Decimal(14, 2)
  /// Challan no as written on the customer's copy.
  challanManual  String?   @db.VarChar(60)
  grnNumber      String?   @db.VarChar(60)
  submissionDate DateTime? @db.Date

  bill     SalesBill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  delivery SalesDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@unique([billId, deliveryId])
  @@index([deliveryId])
  @@map("sales_bill_lines")
}

// ─── Purchase ─────────────────────────────────────────────────────────────────

model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  businessUnitId String   @db.Uuid
  code           String   @db.VarChar(30)
  name           String   @db.VarChar(150)
  contactPerson  String?  @db.VarChar(150)
  email          String?  @db.VarChar(254)
  phone          String?  @db.VarChar(30)
  address        String?  @db.VarChar(500)
  taxNumber      String?  @db.VarChar(50)
  type           String   @default("LOCAL") @db.VarChar(30)
  status         String   @default("ACTIVE") @db.VarChar(30)
  balance        Decimal  @default(0) @db.Decimal(14, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  // Supplier Profile (Configuration › Entity Master Data). `name` is the partner name,
  // `phone` the mobile number and `address` the billing address.
  officeId                   String?  @db.Uuid
  groupId                    String?  @db.Uuid
  subGroupId                 String?  @db.Uuid
  creditDays                 Int?
  tolerancePercent           Decimal? @db.Decimal(5, 2)
  binNumber                  String?  @db.VarChar(30)
  tcsPercent                 Decimal? @db.Decimal(5, 2)
  vatRegistrationNo          String?  @db.VarChar(50)
  tinNumber                  String?  @db.VarChar(50)
  tradeLicenseNo             String?  @db.VarChar(50)
  isMonthly                  Boolean  @default(false)
  isForeign                  Boolean  @default(false)
  vdsApplicable              Boolean  @default(false)
  vatAccountingNotApplicable Boolean  @default(false)
  isUser                     Boolean  @default(false)
  districtId                 Int?
  thanaId                    String?  @db.Uuid
  billingContactNo           String?  @db.VarChar(30)
  taxBracketId               String?  @db.Uuid
  remarks                    String?  @db.VarChar(1000)

  businessUnit   BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  office         Office?           @relation(fields: [officeId], references: [id], onDelete: Restrict)
  group          SupplierGroup?    @relation("SupplierGroup", fields: [groupId], references: [id], onDelete: SetNull)
  subGroup       SupplierGroup?    @relation("SupplierSubGroup", fields: [subGroupId], references: [id], onDelete: SetNull)
  district       District?         @relation(fields: [districtId], references: [id], onDelete: SetNull)
  thana          Thana?            @relation(fields: [thanaId], references: [id], onDelete: SetNull)
  taxBracket     TaxBracket?       @relation(fields: [taxBracketId], references: [id], onDelete: SetNull)
  details        SupplierDetail[]
  attachments    SupplierAttachment[]
  offerDiscountLines SalesOfferDiscountLine[] @relation("OfferDiscountSupplier")
  offerSpecialLines  SalesOfferSpecialLine[]  @relation("OfferSpecialSupplier")
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  returns        PurchaseReturn[]
  payments       SupplierPayment[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, name])
  @@index([officeId])
  @@map("suppliers")
}

/// Partner Group and Sub Group of the Supplier Profile; a sub group has a parent.
model SupplierGroup {
  id             String   @id @default(uuid()) @db.Uuid
  businessUnitId String   @db.Uuid
  parentId       String?  @db.Uuid
  name           String   @db.VarChar(100)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  businessUnit      BusinessUnit    @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  parent            SupplierGroup?  @relation("SupplierGroupTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          SupplierGroup[] @relation("SupplierGroupTree")
  suppliers         Supplier[]      @relation("SupplierGroup")
  subGroupSuppliers Supplier[]      @relation("SupplierSubGroup")

  @@unique([businessUnitId, parentId, name])
  @@map("supplier_groups")
}

/// Bangladesh districts (reference data, seeded by the migration).
model District {
  id        Int        @id
  name      String     @unique @db.VarChar(50)
  division  String     @db.VarChar(30)
  thanas            Thana[]
