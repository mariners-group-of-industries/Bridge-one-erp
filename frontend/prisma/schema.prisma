model PurchaseReturnLine {
  id        String         @id @default(uuid()) @db.Uuid
  returnId  String         @db.Uuid
  lineNo    Int
  itemId    String?        @db.Uuid
  itemCode  String         @db.VarChar(50)
  itemName  String         @db.VarChar(200)
  uom       String         @default("Pcs") @db.VarChar(20)
  qty       Decimal        @db.Decimal(14, 3)
  unitPrice Decimal        @db.Decimal(14, 2)
  amount    Decimal        @db.Decimal(14, 2)
  reason    String?        @db.VarChar(500)

  ret       PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  item      Item?          @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([returnId, lineNo])
  @@map("purchase_return_lines")
}

enum PurchasePaymentMethod {
  CASH
  BANK
  CHEQUE
  ONLINE
}

enum PurchasePaymentStatus {
  DRAFT
  PAID
  CANCELLED
}

model SupplierPayment {
  id              String                @id @default(uuid()) @db.Uuid
  businessUnitId  String                @db.Uuid
  supplierId      String                @db.Uuid
  orderId         String?               @db.Uuid
  number          String                @db.VarChar(30)
