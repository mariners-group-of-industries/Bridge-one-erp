# Copy to `.env` and fill in. Never commit `.env`.

# ─── Database (Neon PostgreSQL) ─────────────────────────────────────────────
# Pooled connection used by the application at runtime (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct (unpooled) connection used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ─── Authentication ─────────────────────────────────────────────────────────
# No authentication provider is integrated yet; configuration APIs reject all
# requests unless this bypass is enabled. Ignored when NODE_ENV=production.
# Local development only.
ERP_DEV_AUTH_BYPASS="false"

# ─── Object storage for office branding files ──────────────────────────────
# "local" stores files on disk (development / single server only).
STORAGE_DRIVER="local"
# Defaults to ./.storage when empty.
STORAGE_LOCAL_DIR=""
