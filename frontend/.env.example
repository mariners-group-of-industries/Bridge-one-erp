# Copy this file to .env and fill in the values.
# Never commit .env — it is git-ignored.

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Pooled connection — used by the app at runtime.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=verify-full&channel_binding=require"

# Direct (unpooled) connection — used by Prisma CLI (migrate, studio).
DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require"

# ── Auth (RS256 JWT) ──────────────────────────────────────────────────────────
# Generate a keypair with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log('PRIVATE:'+privateKey.replace(/\n/g,'\\\\n'));console.log('PUBLIC:'+publicKey.replace(/\n/g,'\\\\n'));"
# Paste the output below (keep \n as literal \n, not real newlines).
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<key>\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<key>\n-----END PUBLIC KEY-----"
JWT_ISSUER="bridgeone-erp"
JWT_AUDIENCE="bridgeone-erp-client"
JWT_EXPIRY="8h"

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=""

# ── Seed ─────────────────────────────────────────────────────────────────────
# Required by `npx tsx prisma/seed.ts` — never commit real values.
SEED_ADMIN_PHONE="<phone>"
SEED_ADMIN_PASSWORD="<password>"

# ── Client-side storage ───────────────────────────────────────────────────────
NEXT_PUBLIC_ACCOUNTING_STORAGE_KEY="bridgeone_accounting_v10"

# ── Business Analyst assistant ────────────────────────────────────────────────
# Hugging Face access token with "Make calls to Inference Providers" permission
# (huggingface.co/settings/tokens). Without it the chat head shows a setup message.
HF_TOKEN=""
# Optional: any chat model with tool calling (default Qwen/Qwen3-235B-A22B-Instruct-2507).
ASSISTANT_MODEL=""
# Optional: another OpenAI-compatible endpoint, e.g. a self-hosted TGI / vLLM / Ollama
# server ("http://localhost:11434/v1") to keep ERP data in-house.
ASSISTANT_API_URL=""
